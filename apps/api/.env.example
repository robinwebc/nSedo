# Local defaults for docker-compose. Replace every secret before a public deploy.
DATABASE_URL=postgresql://nsedo:nsedo@localhost:5432/nsedo
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
PORT=4000
WEB_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOAD_DIR=./uploads

# Comma-separated. Accounts with these emails become ADMIN on register or sign-in.
# Empty value disables the automatic promotion. Unset defaults to the address below.
ADMIN_EMAILS=robinwebc@gmail.com

# Google ID token audience (Web client ID from Google Cloud / Firebase).
GOOGLE_CLIENT_ID=

# SMS: console (log the code) or http (POST {to,message} to SMS_HTTP_URL).
SMS_PROVIDER=console
SMS_HTTP_URL=

# SMTP. When SMTP_HOST is empty, email codes are printed to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nsedo.app

# Optional TURN for calls and live video across strict NATs.
# STUN stun:stun.l.google.com:19302 is always included.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
